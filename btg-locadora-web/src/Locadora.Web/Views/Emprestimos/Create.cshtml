@model EmprestimoFormViewModel
@{
    ViewData["Title"] = "Novo empréstimo";
}

<h1>Novo empréstimo</h1>

<form asp-action="Create" method="post">
    <input type="hidden" asp-for="ChaveIdempotencia" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3 position-relative" data-autocomplete-single
         data-autocomplete-url="@Url.Action("BuscarJogos")"
         data-autocomplete-min="3">
        <label class="form-label">Jogo <span class="badge text-bg-light text-secondary border fw-normal" title="Campo com busca automática: digite ao menos 3 letras">🔍 busca automática</span></label>
        <input type="text" class="form-control" data-autocomplete-input placeholder="Digite ao menos 3 letras..." autocomplete="off" />
        <div class="list-group position-absolute w-100 shadow-sm d-none" style="z-index: 1000;" data-autocomplete-lista></div>
        <input type="hidden" data-autocomplete-hidden asp-for="JogoId" />
        <span asp-validation-for="JogoId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AmigoId" class="form-label"></label>
        <select asp-for="AmigoId" asp-items="Model.Amigos" class="form-select">
            <option value="">Selecione...</option>
        </select>
        <span asp-validation-for="AmigoId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Registrar empréstimo</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
