@model IEnumerable<Jogo>
@{
    ViewData["Title"] = "Jogos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Jogos</h1>
    <a asp-action="Create" class="btn btn-primary">Novo jogo</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="busca" value="@ViewData["Busca"]" class="form-control" placeholder="Buscar por nome..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
    </div>
</form>

@if (!Model.Any())
{
    <p class="text-muted">Nenhum jogo cadastrado.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Gêneros</th>
                <th>Desenvolvedores</th>
                <th>Publicadoras</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var jogo in Model)
            {
                <tr>
                    <td>@jogo.Nome</td>
                    <td>@string.Join(", ", jogo.Generos.Select(g => g.Nome))</td>
                    <td>@string.Join(", ", jogo.Desenvolvedores.Select(d => d.Nome))</td>
                    <td>@string.Join(", ", jogo.Publicadoras.Select(p => p.Nome))</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@jogo.Id" class="btn btn-sm btn-outline-secondary">Detalhes</a>
                        <a asp-action="Edit" asp-route-id="@jogo.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <a asp-action="Delete" asp-route-id="@jogo.Id" class="btn btn-sm btn-outline-danger">Remover</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
