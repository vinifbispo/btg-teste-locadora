@{
    ViewData["Title"] = "Início";
}

<div class="text-center">
    <h1 class="display-5">Bem-vindo à Locadora</h1>
    <p class="lead">Gerencie amigos, jogos e empréstimos.</p>
</div>

<div class="row g-4 mt-3">
    <div class="col-md-4">
        <div class="card h-100 text-center">
            <div class="card-body">
                <h5 class="card-title">Amigos</h5>
                <p class="card-text">Cadastre e gerencie os amigos que podem pegar jogos emprestados.</p>
                <a asp-controller="Amigos" asp-action="Index" class="btn btn-primary">Ver amigos</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 text-center">
            <div class="card-body">
                <h5 class="card-title">Jogos</h5>
                <p class="card-text">Consulte o catálogo de jogos disponíveis para empréstimo.</p>
                <a asp-controller="Jogos" asp-action="Index" class="btn btn-primary">Ver jogos</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 text-center">
            <div class="card-body">
                <h5 class="card-title">Empréstimos</h5>
                <p class="card-text">Registre empréstimos e devoluções de jogos.</p>
                <a asp-controller="Emprestimos" asp-action="Index" class="btn btn-primary">Ver empréstimos</a>
            </div>
        </div>
    </div>
</div>
