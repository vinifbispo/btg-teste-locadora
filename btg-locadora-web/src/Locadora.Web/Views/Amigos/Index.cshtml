@model IEnumerable<Amigo>
@{
    ViewData["Title"] = "Amigos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Amigos</h1>
    <a asp-action="Create" class="btn btn-primary">Novo amigo</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="busca" value="@ViewData["Busca"]" class="form-control" placeholder="Buscar por nome..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Buscar</button>
    </div>
</form>

@if (!Model.Any())
{
    <p class="text-muted">Nenhum amigo cadastrado.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Idade</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var amigo in Model)
            {
                <tr>
                    <td>@amigo.Nome @amigo.Sobrenome</td>
                    <td>@amigo.Idade</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@amigo.Id" class="btn btn-sm btn-outline-secondary">Detalhes</a>
                        <a asp-action="Edit" asp-route-id="@amigo.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <a asp-action="Delete" asp-route-id="@amigo.Id" class="btn btn-sm btn-outline-danger">Remover</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
